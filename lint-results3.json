ce`] && <p className=\"text-xs text-red-500\">{errors[`packages.${index}.price`]}</p>}\r\n                                            </div>\r\n\r\n                                            <div className=\"space-y-2\">\r\n                                                <Label>{__('general.delivery_days')}<span className=\"text-red-500\">*</span></Label>\r\n                                                <Input \r\n                                                    type=\"number\" \r\n                                                    min=\"1\"\r\n                                                    value={pkg.delivery_days} \r\n                                                    onChange={(e) => updatePackage(index, 'delivery_days', e.target.value)} \r\n                                                    required\r\n                                                />\r\n                                                {/* @ts-expect-error */}\r\n                                                {errors[`packages.${index}.delivery_days`] && <p className=\"text-xs text-red-500\">{errors[`packages.${index}.delivery_days`]}</p>}\r\n                                            </div>\r\n\r\n                                            <div className=\"space-y-2 md:col-span-2\">\r\n                                                <Label>{__('general.package_description')}<span className=\"text-red-500\">*</span></Label>\r\n                                                <Textarea \r\n                                                    value={pkg.description} \r\n                                                    onChange={(e) => updatePackage(index, 'description', e.target.value)} \r\n                                                    rows={2}\r\n                                                    required\r\n                                                />\r\n                                                {/* @ts-expect-error */}\r\n                                                {errors[`packages.${index}.description`] && <p className=\"text-xs text-red-500\">{errors[`packages.${index}.description`]}</p>}\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                ))}\r\n                            </div>\r\n                        </div>\r\n\r\n                    </form>\r\n                </div>\r\n            </div>\r\n        </AdminSidebarLayout>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\Projects\\1AOrganized\\PhpProject\\MusoftwareBusiness\\Musoftwares\\resources\\js\\Pages\\Admin\\Marketplace\\Orders\\Index.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Projects\\1AOrganized\\PhpProject\\MusoftwareBusiness\\Musoftwares\\resources\\js\\Pages\\Admin\\Marketplace\\Orders\\Show.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Projects\\1AOrganized\\PhpProject\\MusoftwareBusiness\\Musoftwares\\resources\\js\\Pages\\Admin\\Marketplace\\Pending.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Projects\\1AOrganized\\PhpProject\\MusoftwareBusiness\\Musoftwares\\resources\\js\\Pages\\Admin\\Marketplace\\ServiceLandingPages\\Index.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Projects\\1AOrganized\\PhpProject\\MusoftwareBusiness\\Musoftwares\\resources\\js\\Pages\\Admin\\PaymentGateway\\Index.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fat