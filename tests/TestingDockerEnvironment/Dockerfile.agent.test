FROM node:22-alpine

# Install Python for the Python runtime
RUN apk add --no-cache python3 py3-pip zip build-base linux-headers

WORKDIR /app

# The docker-compose will mount /app/runtime to the tools/musoftware-runtime directory
# so we don't need to copy the source files here, just prepare the environment.

CMD ["sh", "-c", "cd /app/runtime && npm install && npm start"]
