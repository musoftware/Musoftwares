###############################################################################
# LARAVEL / PHP
###############################################################################

# Dependencies & build output
/node_modules
/public/build
/public/hot
/public/storage
/vendor

# Environment & secrets
.env
.env.backup
.env.production
.env.staging
.env.*.local
.env.*-bak
.env.*.bak

# Laravel storage (logs, framework cache, uploaded files)
/storage/logs/*.log
/storage/framework/cache/data/
/storage/framework/sessions/
/storage/framework/testing/
/storage/framework/views/
/storage/app/public/

# Keys & auth
/storage/*.key
auth.json

# PHPUnit / test cache
.phpunit.result.cache
.phpunit.cache/

# Homestead / Sail
Homestead.json
Homestead.yaml
docker-compose.override.yml

# Compiled assets / lock files (non-root)
Modules/*/vite.config.js

# Misc debug logs (root level)
npm-debug.log
yarn-error.log
.pnpm-debug.log
server.log
server*.log

# Scratch / temp
/scratch/
/dev_scripts/
/routes.txt

###############################################################################
# MUSOFTWARE RUNTIME — tools/musoftware-runtime
###############################################################################

# Dependencies
tools/musoftware-runtime/node_modules/
tools/musoftware-runtime/plugins/*/node_modules/

# Environment & secrets
tools/musoftware-runtime/.env
tools/musoftware-runtime/.env.local
tools/musoftware-runtime/.env.*.local

# Runtime logs
tools/musoftware-runtime/logs/
tools/musoftware-runtime/*.log

# SQLite runtime database (runtime state — not source)
tools/musoftware-runtime/storage/*.db
tools/musoftware-runtime/storage/*.db-shm
tools/musoftware-runtime/storage/*.db-wal

# Downloaded / cached runtime binaries (Node.js, Python, etc.)
# These are fetched on first run; never commit large binaries.
tools/musoftware-runtime/runtimes/downloads/
tools/musoftware-runtime/runtimes/*.zip
tools/musoftware-runtime/runtimes/*.tar.gz
tools/musoftware-runtime/runtimes/*.tar.xz

# Build / distribution output
tools/musoftware-runtime/dist/
tools/musoftware-runtime/build/
tools/musoftware-runtime/out/

# Packaged desktop installers (electron-builder, pkg, etc.)
tools/musoftware-runtime/release/
tools/musoftware-runtime/*.exe
tools/musoftware-runtime/*.dmg
tools/musoftware-runtime/*.AppImage
tools/musoftware-runtime/*.deb
tools/musoftware-runtime/*.rpm
tools/musoftware-runtime/*.snap

# Lock files (keep package-lock.json; ignore yarn/pnpm alternatives)
tools/musoftware-runtime/yarn.lock
tools/musoftware-runtime/pnpm-lock.yaml

# Misc debug logs
tools/musoftware-runtime/.pnpm-debug.log
tools/musoftware-runtime/npm-debug.log

