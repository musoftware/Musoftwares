# Test environment for Pest / PHPUnit.
# Copy to .env.testing and run: php artisan key:generate --env=testing
# phpunit.xml overrides DB, cache, queue, mail and session drivers.
# Never put real credentials in this file.

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

DB_OLD_DATABASE=oldmusoftware
DB_OLD_USERNAME=root
DB_OLD_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

IMAP_HOST=imap.test.local
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=false
IMAP_USERNAME=inbox@test.local
IMAP_PASSWORD=change-me
IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=7
IMAP_DOMAIN=test.local
GUEST_TICKET_INBOX=admin@test.local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=

KASHIER_MERCHANT_ID=MID-test
KASHIER_SECRET=test-secret
KASHIER_MODE=test
