   {currentPoints < pointsCost ? (\r\n                                <p className=\"text-sm text-amber-700 font-semibold bg-amber-100/60 px-3 py-1 rounded-full inline-flex items-center gap-1.5 border border-amber-200/50\">\r\n                                    {__('Insufficient balance:')} {currentPoints} {__('pts')} ({__('Need')} {pointsCost - currentPoints} {__('pts more')})\r\n                                </p>\r\n                            ) : (\r\n                                <p className=\"text-sm text-indigo-700 flex items-center justify-center gap-2\">\r\n                                    {__('Your balance:')} {currentPoints} {__('pts')} <span className=\"text-xl\">&rarr;</span> {__('after:')} <span className=\"font-bold\">{currentPoints - pointsCost} {__('pts')}</span>\r\n                                </p>\r\n                            )}\r\n                        </div>\r\n\r\n                        {errors.points && <div className=\"text-red-500 mb-4 bg-red-50 p-3 rounded-lg border border-red-200 w-full text-center\">{errors.points}</div>}\r\n\r\n                        {currentPoints < pointsCost ? (\r\n                            <button\r\n                                type=\"button\"\r\n                                onClick={handleBuyPointsToPublish}\r\n                                className=\"bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 px-8 rounded-lg shadow-md transition text-lg w-full md:w-auto flex items-center justify-center gap-2 hover:scale-[1.02] transform duration-150\"\r\n                            >\r\n                                <Zap className=\"h-5 w-5 fill-amber-300 stroke-amber-100 animate-pulse\" /> {__('Buy')} {pointsCost - currentPoints} {__('Points to Publish')}\r\n                            </button>\r\n                        ) : (\r\n                            <button\r\n                                type=\"submit\"\r\n                                disabled={processing}\r\n                                className=\"bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg shadow-sm transition text-lg w-full md:w-auto\"\r\n                            >\r\n                                {__('Publish Job')} — {pointsCost} {__('pts')}\r\n                            </button>\r\n                        )}\r\n                    </div>\r\n                </form>\r\n            </div>\r\n        </FreelanceLayout>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\Projects\\1AOrganized\\PhpProject\\MusoftwareBusiness\\Musoftwares\\resources\\js\\Pages\\Freelance\\Jobs\\Edit.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Projects\\1AOrganized\\PhpProject\\MusoftwareBusiness\\Musoftwares\\resources\\js\\Pages\\Freelance\\Jobs\\Index.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Projects\\1AOrganized\\PhpProject\\MusoftwareBusiness\\Musoftwares\\resources\\js\\Pages\\Freelance\\Jobs\\MyJobs.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Projects\\1AOrganized\\PhpProject\\MusoftwareBusiness\\Musoftwares\\resources\\js\\Pages\\Freelance\\Jobs\\Show.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Projects\\1AOrganized\\PhpProject\\MusoftwareBusiness\\Musoftwares\\resources\\js\\Pages\\Freelance\\Layout.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\Proje