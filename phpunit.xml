<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!-- ── Core Unit Tests ── -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>

        <!-- ── Core Feature Tests (Admin Panel + Platform) ── -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>

        <!-- ── Marketplace Module ── -->
        <testsuite name="Marketplace">
            <directory>Modules/Marketplace/Tests/Feature</directory>
        </testsuite>

        <!-- ── Shortlink Module ── -->
        <testsuite name="Shortlink">
            <directory>Modules/Shortlink/Tests/Feature</directory>
        </testsuite>

        <!-- ── SMS Payment Gateway Module ── -->
        <testsuite name="SmsPaymentGateway">
            <directory>Modules/SmsPaymentGateway/tests/Unit</directory>
            <directory>Modules/SmsPaymentGateway/tests/Feature</directory>
        </testsuite>

        <!-- ── WhatsappSender Module ── -->
        <testsuite name="WhatsappSender">
            <directory>Modules/WhatsappSender/Tests/Feature</directory>
        </testsuite>

        <!-- ── Listing Module ── -->
        <testsuite name="Listing">
            <directory>Modules/Listing/tests/Feature</directory>
        </testsuite>

        <!-- ── PasswordSync Module ── -->
        <testsuite name="PasswordSync">
            <directory>Modules/PasswordSync/tests/Feature</directory>
        </testsuite>

        <!-- ── Series Module ── -->
        <testsuite name="Series">
            <directory>Modules/Series/tests/Feature</directory>
        </testsuite>

        <!-- ── Fbmb Module ── -->
        <testsuite name="Fbmb">
            <directory>Modules/Fbmb/Tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="APP_BUSINESS_TIMEZONE" value="UTC"/>
    </php>
</phpunit>
