<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!-- ── Core Unit Tests ── -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <directory>Modules/Shared/tests/Unit</directory>
        </testsuite>

        <!-- ── Core Feature Tests (Admin Panel + Platform) ── -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <directory>Modules/Shared/tests/Feature</directory>
        </testsuite>

        <!-- ── ERP Module (All Features + Addons) ── -->
        <testsuite name="ERP">
            <directory>Modules/ERP/Tests/Feature</directory>
        </testsuite>

        <!-- ── Freelance Module ── -->
        <testsuite name="Freelance">
            <directory>Modules/Freelance/Tests/Feature</directory>
            <directory>Modules/Freelance/Tests/Unit</directory>
            <directory>Modules/Freelance/Tests/Finance</directory>
            <directory>Modules/Freelance/Tests/Security</directory>
            <directory>Modules/Freelance/Tests/Concurrency</directory>
            <directory>Modules/Freelance/Tests/Performance</directory>
        </testsuite>

        <!-- ── CRM Module ── -->
        <testsuite name="CRM">
            <directory>Modules/CRM/Tests/Feature</directory>
        </testsuite>

        <!-- ── Marketplace Module ── -->
        <testsuite name="Marketplace">
            <directory>Modules/Marketplace/Tests/Feature</directory>
        </testsuite>

        <!-- ── Booking Module ── -->
        <testsuite name="Booking">
            <directory>Modules/Booking/tests/Feature</directory>
            <directory>Modules/Booking/tests/Unit</directory>
        </testsuite>



        <!-- ── GoldSavers Module ── -->
        <testsuite name="GoldSavers">
            <directory>Modules/GoldSavers/Tests/Feature</directory>
            <directory>Modules/GoldSavers/Tests/Unit</directory>
        </testsuite>

        <!-- ── SMS Payment Gateway Module ── -->
        <testsuite name="SmsPaymentGateway">
            <directory>Modules/SmsPaymentGateway/tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
