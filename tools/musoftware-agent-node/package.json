{
  "name": "musoftware-agent-node",
  "version": "1.0.0",
  "description": "Musoftware Node.js Runtime Agent — handles WhatsApp, TikTok, Puppeteer, browser automation tools",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:win": "pkg . --target node18-win-x64 --output dist/musoftware-agent-node-win.exe",
    "build:mac": "pkg . --target node18-macos-x64 --output dist/musoftware-agent-node-mac",
    "build:linux": "pkg . --target node18-linux-x64 --output dist/musoftware-agent-node-linux"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "semver": "^7.5.4",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "config/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
