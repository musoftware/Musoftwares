{
  "name": "musoftware-runtime",
  "version": "1.0.0",
  "description": "Musoftware Unified Runtime Agent — multi-language plugin orchestrator",
  "main": "core/index.js",
  "type": "commonjs",
  "scripts": {
    "start":      "node core/index.js",
    "dev":        "node --watch core/index.js",
    "build:win":  "pkg . --target node22-win-x64  --output dist/musoftware-runtime-win.exe",
    "build:mac":  "pkg . --target node22-macos-x64 --output dist/musoftware-runtime-mac",
    "build:linux":"pkg . --target node22-linux-x64 --output dist/musoftware-runtime-linux"
  },
  "dependencies": {
    "dotenv":       "^16.3.1",
    "express":      "^4.18.2",
    "ws":           "^8.14.2",
    "axios":        "^1.6.2",
    "uuid":         "^9.0.0",
    "winston":      "^3.11.0",
    "cors":         "^2.8.5",
    "helmet":       "^7.1.0",
    "semver":       "^7.5.4",
    "better-sqlite3": "^9.4.3",
    "adm-zip":      "^0.5.10"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": ["core/**/*", "config/**/*"],
    "targets": ["node22-win-x64", "node22-macos-x64", "node22-linux-x64"]
  },
  "engines": { "node": ">=22.0.0" }
}
