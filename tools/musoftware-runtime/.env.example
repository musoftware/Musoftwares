# ─────────────────────────────────────────────────────────────
# Musoftware Runtime Agent — Environment Template
# ─────────────────────────────────────────────────────────────
# Copy to .env for local development ONLY.
# In production: NO .env file. Runtime uses browser login flow.
# ─────────────────────────────────────────────────────────────

# Platform URL (production: https://musoftware.com)
MUSOFTWARE_PLATFORM=https://musoftware.com

# Dev only: override ports
# MUSOFTWARE_PORT=18400
# MUSOFTWARE_WS_PORT=18401
# MUSOFTWARE_LOG_LEVEL=debug
# NODE_TLS_REJECT_UNAUTHORIZED=0
