{
  "id": "whatsapp-sender",
  "name": "WhatsApp Bulk Sender",
  "version": "2.0.0",
  "runtime": "nodejs",
  "entry": "worker.js",
  "tool_slug": "whatsapp-sender",
  "description": "Advanced WhatsApp messaging with humanization, deliverability tracking, health scoring, and ban prevention — bulk campaigns, media, personalization.",
  "permissions": ["browser", "network", "filesystem"],
  "autoStart": false,
  "capabilities": [
    "send_text",
    "send_media",
    "bulk_campaign",
    "session_persistence",
    "humanized_sending",
    "deliverability_tracking",
    "health_scoring",
    "block_rate_monitoring",
    "message_variation",
    "proxy_support"
  ],
  "requires_runtime": ">=1.0.0",
  "timeoutSeconds": 600
}
