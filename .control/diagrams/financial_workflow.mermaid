flowchart TD
    Start([User initiates Financial Action])
    
    Start --> ActionType{Select Action}
    
    ActionType -->|Top-up| WalletTopUp[Wallet Top-Up]
    ActionType -->|Subscription| SaaS[SaaS Subscription]
    ActionType -->|Purchase| Invoice[Recurring Invoice]
    
    WalletTopUp --> CurrencyCheck{Dual-Currency Processing?}
    SaaS --> CurrencyCheck
    Invoice --> CurrencyCheck
    
    CurrencyCheck -->|Yes| Conversion[Currency Conversion Service]
    CurrencyCheck -->|No| Process[Process Transaction]
    
    Conversion --> Process
    
    Process --> Success{Successful?}
    
    Success -->|Yes| UpdateBalance[Update Wallet/Credits]
    UpdateBalance --> ActivateFeature[Activate Feature/License]
    ActivateFeature --> End([Complete])
    
    Success -->|No| Fail[Log Failure & Notify User]
    Fail --> End
