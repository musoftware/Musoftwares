flowchart TD
    phase1_init[Phase 1: Core Setup] --> be_setup[Backend: Laravel 12, PHP 8.2]
    phase1_init --> fe_setup[Frontend: React 18, TS 5, Vite 7]
    phase1_init --> db_setup[Data Layer: MySQL/PgSQL, Redis, Meilisearch]

    be_setup --> be_packages[Install Backend Packages]
    be_packages --> pkg_modules[nwidart/laravel-modules]
    be_packages --> pkg_auth[Sanctum, Breeze, Socialite]
    be_packages --> pkg_roles[Spatie Permissions/Model States]
    be_packages --> pkg_ws[Laravel Reverb]

    fe_setup --> fe_packages[Install Frontend Packages]
    fe_packages --> pkg_inertia[Inertia.js 2.0]
    fe_packages --> pkg_styles[Tailwind CSS v4, Shadcn UI]
    fe_packages --> pkg_state[Zustand 5.0.14]
    fe_packages --> pkg_viz[Recharts, React Flow]
    fe_packages --> pkg_anim[GSAP, Framer Motion]

    pkg_modules --> phase2_auth[Phase 2: Auth & Onboarding]
    pkg_auth --> phase2_auth
    pkg_inertia --> phase2_auth

    phase2_auth --> route_login[Implement /login & /register]
    route_login --> route_verify[Implement /verify-email & /two-factor-challenge]
    route_verify --> route_onboard[Implement /onboarding/kyc & /onboarding/workspace]

    route_onboard --> phase3_core[Phase 3: Core Dashboard & Settings]
    phase3_core --> route_dash[Implement /dashboard with Recharts & Reverb]
    route_dash --> route_settings[Implement /settings Profile, Security, Workspace]
    route_settings --> route_notif[Implement /notifications Hub]

    route_notif --> phase4_modules[Phase 4: Domain Modules]

    phase4_modules --> mod_billing[Billing Module]
    mod_billing --> bill_wallet[Implement /billing/wallet Dual-Currency]
    bill_wallet --> bill_subs[Implement /billing/subscriptions]
    bill_subs --> bill_inv[Implement /billing/invoices & PDF Gen]

    phase4_modules --> mod_erp[ERP Module]
    mod_erp --> erp_hr[Implement HR: Depts, Employees, Attendance, Payroll]
    erp_hr --> erp_assets[Implement Assets & Cost Centers]
    erp_assets --> erp_supply[Implement Supply Chain: POs, Inventory]
    erp_supply --> erp_finance[Implement Finance: Ledgers, Reports]

    phase4_modules --> mod_crm[CRM Module]
    mod_crm --> crm_leads[Implement /crm/leads Kanban with React Flow]
    crm_leads --> crm_rest[Implement Campaigns, Tickets, Comms]

    phase4_modules --> mod_proj[Project Module]
    mod_proj --> proj_board[Implement /projects board with Framer Motion]
    proj_board --> proj_time[Implement Time Tracking]

    phase4_modules --> mod_market[Marketplace Module]
    mod_market --> market_catalog[Implement Catalog & Product Pages]
    market_catalog --> market_cart[Implement Cart & Wallet Checkout]
    market_cart --> market_license[Implement License Generation]

    phase4_modules --> mod_book[Booking Module]
    mod_book --> book_cal[Implement Booking Calendar]

    bill_inv --> phase5_polish[Phase 5: Refinement & Edge Cases]
    erp_finance --> phase5_polish
    crm_rest --> phase5_polish
    proj_time --> phase5_polish
    market_license --> phase5_polish
    book_cal --> phase5_polish

    phase5_polish --> opt_tenant[Apply Strict Global Tenant Isolation Scopes]
    opt_tenant --> opt_sync[Sync ERP Transactions with Core Wallet]
    opt_sync --> opt_softdel[Handle Soft Deletes in Historical Views]
    opt_softdel --> opt_inertia[Optimize Inertia Payloads via Partial Reloads]
    opt_inertia --> err_pages[Implement Custom Error Pages: 403, 404, 500, 503]
    err_pages --> final_launch[System Ready]
