# iSAAS Tool — Environment Configuration
# Copy this to .env and fill in your values

# ─── App Identity ─────────────────────────────────────────────────────────────
APP_NAME=My Tool Name
APP_VERSION=1.0.0
TOOL_SLUG=my-tool-slug     # Must match the slug in the marketplace

# ─── iSAAS Backend ───────────────────────────────────────────────────────────
API_BASE_URL=https://isass.app/api/tools
API_TIMEOUT=15
API_RETRY_ATTEMPTS=3

# ─── Session (set automatically after first login) ────────────────────────────
API_TOKEN=
LICENSE_KEY=

# ─── Updates ─────────────────────────────────────────────────────────────────
AUTO_UPDATE_CHECK=true
UPDATE_CHECK_INTERVAL_HOURS=6

# ─── Offline Grace ────────────────────────────────────────────────────────────
OFFLINE_GRACE_DAYS=3

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ─── Local Storage ────────────────────────────────────────────────────────────
DB_PATH=data/local.db
