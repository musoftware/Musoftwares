includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # Analyse as the lowest PHP version allowed by composer.json ("php": "^8.4").
    phpVersion: 80400

    paths:
        - app/
        - Modules/

    # Level 1 catches undefined variables, properties, and methods.
    level: 1

    # Fail when a baseline or ignore entry no longer matches, so stale entries get removed.
    reportUnmatchedIgnoredErrors: true

    excludePaths:
        - Modules/SmsPaymentGateway/sdk/
        - */database/factories/*
        - */database/seeders/*
        - */Tests/*
        - */tests/*
