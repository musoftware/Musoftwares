includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    phpVersion: 80300 # Force PHP 8.3 analysis despite local PHP 8.1 CLI

    paths:
        - app/
        - Modules/

    # Level 1 catches undefined variables, properties, and methods
    level: 1

    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        -
            message: '#^Class App\\Services\\WhatsAppNotificationService not found\.$#'
            paths:
                - Modules/WebTools/Http/Controllers/Financial/PayGuestController.php
                - Modules/WebTools/Http/Controllers/Financial/WithdrawInstapayController.php

    excludePaths:
        - Modules/SmsPaymentGateway/sdk/
        - */database/factories/*
        - */database/seeders/*
        - */Tests/*
