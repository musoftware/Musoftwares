includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # Analyse as the lowest PHP version allowed by composer.json ("php": "^8.4").
    phpVersion: 80400

    paths:
        - app/
        - Modules/

    # Modules keep their own config and migrations: env() is allowed in their config files, and their models'
    # columns come from their migrations. Setting these replaces Larastan's defaults, so the app's own are listed too.
    configDirectories:
        - '%currentWorkingDirectory%/config'
        - '%currentWorkingDirectory%/Modules/*/[Cc]onfig'
    databaseMigrationsPath:
        - '%currentWorkingDirectory%/database/migrations'
        - '%currentWorkingDirectory%/Modules/*/[Dd]atabase/[Mm]igrations'

    # Level 1 catches undefined variables, properties, and methods.
    level: 1

    # Fail when a baseline or ignore entry no longer matches, so stale entries get removed.
    reportUnmatchedIgnoredErrors: true

    excludePaths:
        - Modules/SmsPaymentGateway/sdk/
        - */database/factories/*
        - */database/seeders/*
        - */Tests/*
        - */tests/*
