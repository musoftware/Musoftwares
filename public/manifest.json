      "type": "image/png"
    },
    {
      "src": "/icons/pwa-180.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icons/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/pwa-256.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "/icons/pwa-384.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "/icons/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "monochrome"
    }
  ],
  "shortcuts": [
    {
      "name": "My Dashboard",
      "short_name": "Dashboard",
      "description": "Open your workspace dashboard",
      "url": "/dashboard?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-dashboard.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tools",
      "short_name": "Tools",
      "description": "Access all your automation tools",
      "url": "/tools?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-tools.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/images/hero_illustration.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Musoftware Automation Dashboard"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+musoftware",
      "url": "/dashboard?protocol=%s"
    }
  ],
  "share_target": {
    "action": "/dashboard?shared=true",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "/dashboard",
      "accept": {
        "text/json": [
          ".json"
        ],
        "application/json": [
          ".json"
        ]
      },
      "icons": [
        {
          "src": "/icons/pwa-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  }
}
